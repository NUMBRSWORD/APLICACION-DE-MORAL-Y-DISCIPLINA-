<resources>
    <style name="Base.Theme.MESADEPARTES" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde_pnp</item>
        <item name="colorOnPrimary">@color/sobre_primario</item>
        <item name="colorPrimaryContainer">@color/verde_suave</item>
        <item name="colorOnPrimaryContainer">@color/verde_oscuro</item>
        <item name="colorSecondary">@color/dorado</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/dorado_suave</item>
        <item name="colorOnSecondaryContainer">@color/texto_principal</item>
        <item name="colorSurface">@color/fondo_app</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="colorSurfaceVariant">@color/superficie_elevada</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/borde_suave</item>
        <item name="android:colorAccent">@color/verde_pnp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/fondo_app</item>
        <item name="android:navigationBarColor">@color/fondo_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.MESADEPARTES.Button</item>
        <item name="textInputStyle">@style/Widget.MESADEPARTES.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.MESADEPARTES.Card</item>
    </style>

    <style name="Theme.MESADEPARTES" parent="Base.Theme.MESADEPARTES" />

    <style name="Text.Paso" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textColor">@color/texto_sobre_verde</item>
        <item name="android:background">@drawable/bg_step</item>
    </style>

    <style name="Theme.MESADEPARTES.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/verde_profundo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mascota</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/mascota_fondo_verde</item>
        <item name="postSplashScreenTheme">@style/Theme.MESADEPARTES</item>
        <!-- El fondo de arranque es verde oscuro: la hora y los iconos del sistema van en claro. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/verde_profundo</item>
    </style>

    <style name="Widget.MESADEPARTES.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.MESADEPARTES.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/borde_suave</item>
    </style>

    <!--
      Botón de acceso con Google conforme a sus normas de marca: fondo blanco (negro en
      modo oscuro), borde y color de texto fijados por Google, logotipo sin tinte y el
      texto aprobado "Continuar con Google". No se recolorea ni se deforma.
    -->
    <style name="Widget.MESADEPARTES.Button.Google" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/google_estado_texto</item>
        <item name="backgroundTint">@color/google_estado_fondo</item>
        <item name="strokeColor">@color/google_borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">12dp</item>
        <item name="iconTint">@null</item>
        <item name="rippleColor">@color/google_borde</item>
    </style>

    <style name="Widget.MESADEPARTES.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MESADEPARTES.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/borde_campo</item>
        <item name="hintTextColor">@color/texto_secundario</item>
    </style>

    <style name="Widget.MESADEPARTES.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/superficie_tarjeta</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/borde_suave</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
