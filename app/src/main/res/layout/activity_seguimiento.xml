<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/view_barra_modulo"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/seguimiento_descripcion" android:textSize="16sp" android:lineSpacingExtra="3dp" android:textColor="@color/texto_secundario"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutBuscarPendientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/seguimiento_buscar">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBuscarPendientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/tvCantidadPendientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textStyle="bold" android:textColor="@color/texto_principal"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progreso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"/>
            <include layout="@layout/view_estado"/>
            <TextView android:id="@+id/tvPendientesVacio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_status_info" android:padding="20dp" android:text="@string/seguimiento_vacio" android:textColor="@color/estado_info_texto" android:visibility="gone"/>
            <LinearLayout android:id="@+id/listaPendientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMasPendientes" style="@style/Widget.MESADEPARTES.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/seguimiento_mas" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnActualizarPendientes" style="@style/Widget.MESADEPARTES.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/seguimiento_actualizar"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
