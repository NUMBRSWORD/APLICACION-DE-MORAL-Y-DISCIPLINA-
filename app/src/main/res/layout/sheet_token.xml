<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/token_inferior" android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/texto_principal" android:gravity="center"/>
    <TextView android:id="@+id/tvCodigoInferior" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:textSize="42sp" android:fontFamily="monospace" android:textStyle="bold"
        android:gravity="center" android:textColor="@color/texto_principal"
        android:importantForAutofill="no" android:saveEnabled="false"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoTokenInferior" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:max="30"/>
    <TextView android:id="@+id/tvTiempoInferior" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="16dp"
        android:textColor="@color/texto_secundario" android:textSize="14sp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnVerificarInferior"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:visibility="gone" android:text="@string/token_abrir_verificacion"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCodigosRespaldo"
        style="@style/Widget.MESADEPARTES.Button.Outlined"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/recuperacion_nuevos"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCerrarToken"
        style="@style/Widget.MESADEPARTES.Button.Outlined"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/token_cerrar"/>
</LinearLayout>
